# Loopback-only lab placeholders. Compose binds 0.0.0.0 inside the container
# (non-loopback); replace both values with unique roots before compose up or
# startup refuses the shipped example pair. Host publish stays 127.0.0.1:4588.
NOCTAXRIS_GCP_ROOT_SERVICE_ACCOUNT=root@example.iam.gserviceaccount.com
NOCTAXRIS_GCP_ROOT_ACCESS_TOKEN=noctaxris-gcp-example-root-token
NOCTAXRIS_GCP_PROJECT=noctaxris-gcp-local

# Compose sets NOCTAXRIS_GCP_MASTER_KEY_FILE=/var/lib/noctaxris-gcp-secrets/master.key
# on the noctaxris-gcp-secrets volume (outside noctaxris-gcp-data). Do not colocate
# master.key on the data volume unless you also set:
# NOCTAXRIS_GCP_ALLOW_MASTER_KEY_IN_DATA_ROOT=1
# NOCTAXRIS_GCP_MASTER_KEY_FILE=/var/lib/noctaxris-gcp/master.key
