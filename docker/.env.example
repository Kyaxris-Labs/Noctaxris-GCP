# Loopback-only lab placeholders. Compose binds 0.0.0.0 inside the container
# (non-loopback); replace both values with unique roots before compose up or
# startup refuses the shipped example pair. Host publish stays 127.0.0.1:4588
# unless you set NOCTAXRIS_GCP_PUBLISH_ADDR (lab-only).
NOCTAXRIS_GCP_ROOT_SERVICE_ACCOUNT=root@example.iam.gserviceaccount.com
NOCTAXRIS_GCP_ROOT_ACCESS_TOKEN=noctaxris-gcp-example-root-token
NOCTAXRIS_GCP_PROJECT=noctaxris-gcp-local

# Compose sets NOCTAXRIS_GCP_MASTER_KEY_FILE=/var/lib/noctaxris-gcp-secrets/master.key
# on the noctaxris-gcp-secrets volume (outside noctaxris-gcp-data). Do not colocate
# master.key on the data volume unless you also set:
# NOCTAXRIS_GCP_ALLOW_MASTER_KEY_IN_DATA_ROOT=1
# NOCTAXRIS_GCP_MASTER_KEY_FILE=/var/lib/noctaxris-gcp/master.key

# Nested DinD is ON in default compose.yaml (restricted engine + TLS).
# Never set these to unix:///var/run/docker.sock or mount host docker.sock.
# Compose sets:
#   NOCTAXRIS_GCP_DOCKER_HOST=tcp://noctaxris-gcp-engine:2376
#   NOCTAXRIS_GCP_DOCKER_CERT_PATH=/certs/client
#   NOCTAXRIS_GCP_NESTED_ENGINE_FAIL_CLOSED=1
#   NOCTAXRIS_GCP_NESTED_INVOKE_FAIL_CLOSED=1
# Bare binary / unit tests leave DOCKER_HOST empty (mock/theatre soft-fail).
# Optional: NOCTAXRIS_GCP_DOCKER_HOST_ALLOWLIST=tcp://other-engine:2376
# Optional: NOCTAXRIS_GCP_IMAGE_PULL_ALLOWLIST=ghcr.io/org/ (digest required for registry hosts)
# Optional privileged engine: -f compose.engine-privileged.yaml
# Optional host-gateway lab: -f compose.lab-host-gateway.yaml
